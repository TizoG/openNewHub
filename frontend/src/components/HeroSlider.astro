---
interface Noticias {
    imagen: string;
    titulo: string;
    fuente: string;
    resumen: string;
    url: string;
    fecha_publicacion: string | Date;
}
const { noticias } = Astro.props;

const formatFecha = (fecha: string | Date) => {
    return new Date(fecha).toLocaleDateString('es-ES', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
    });
};
---

<div class="relative group w-full overflow-hidden rounded-2xl">
    <div
        id="slider-container"
        class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-hide"
    >
        {
            noticias.map((noticia: Noticias, index: any) => (
                <div class="min-w-full relative h-[450px] snap-center">
                    <img
                        src={noticia.imagen}
                        class="absolute inset-0 w-full h-full object-cover"
                        referrerpolicy="no-referrer"
                    />

                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
                    <div class="absolute bottom-0 p-10 text-white">
                        <h2 class="text-3xl font-bold mb-2">
                            {noticia.titulo}
                        </h2>
                        <p class="text-gray-300 line-clamp-2">
                            {noticia.resumen}
                        </p>
                        <div class="flex items-center gap-3 text-xs text-gray-400 font-medium">
                            <span>
                                {formatFecha(noticia.fecha_publicacion)}
                            </span>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 z-10">
        {
            noticias.map((_: any, index: any) => (
                <div
                    class="dot w-3 h-3 rounded-full bg-white/40 transition-all duration-300"
                    data-index={index}
                />
            ))
        }
    </div>
</div>
<style>
    /* Ocultar barra de scroll en todos los navegadores */
    .scrollbar-hide {
        -ms-overflow-style: none; /* IE y Edge */
        scrollbar-width: none; /* Firefox */
    }
    .scrollbar-hide::-webkit-scrollbar {
        display: none; /* Chrome, Safari y Opera */
    }
</style>
<script>
    const container = document.getElementById('slider-container');
    const dots = document.querySelectorAll('.dot');

    if (container && dots.length > 0) {
        const updateDots = () => {
            const index = Math.round(
                container.scrollLeft / container.offsetWidth
            );
            dots.forEach((dot, i) => {
                if (i === index) {
                    dot.classList.add('bg-white', 'scale-125');
                    dot.classList.remove('bg-white/40');
                } else {
                    dot.classList.remove('bg-white', 'scale-125');
                    dot.classList.add('bg-white/40');
                }
            });
        };

        // Escuchar el movimiento del scroll para iluminar los puntos
        container.addEventListener('scroll', updateDots);

        // Auto-play mejorado
        setInterval(() => {
            const width = container.offsetWidth;
            const isLast =
                container.scrollLeft + width >= container.scrollWidth - 10;

            if (isLast) {
                container.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
                container.scrollBy({ left: width, behavior: 'smooth' });
            }
        }, 5000);

        // Inicializar el primer punto
        updateDots();
    }
</script>
