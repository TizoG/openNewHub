---
interface Noticias {
    imagen: string;
    titulo: string;
    fuente: string;
    resumen: string;
    url: string;
    fecha_publicacion: string | Date;
    categoria: string;
}
const { noticias } = Astro.props;

const formatFecha = (fecha: string | Date) => {
    return new Date(fecha).toLocaleDateString('es-ES', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
    });
};

const coloresCategorias: Record<string, string> = {
    Tecnología: 'bg-blue-100 text-blue-700',
    Política: 'bg-red-100 text-red-700',
    Deportes: 'bg-green-100 text-green-700',
    Cultura: 'bg-purple-100 text-purple-700',
    Economia: 'bg-yellow-100 text-yellow-700',
    España: 'bg-amber-100 text-amber-700',
    Latinoamérica: 'bg-violet-100 text-violet-700',
    'Es la Mañana de Federico': 'bg-sky-100 text-sky-700',
    default: 'bg-gray-100 text-gray-700',
};
---

<div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between pb-8">
        <h1 class="text-4xl font-bold">Últimas noticias</h1>
        <a href="#" class="text-blue-600 hover:text-blue-800">Ver más </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
        {
            noticias.map((noticia: Noticias) => {
                // ESTO ES LO QUE FALTABA: Calcularlo dentro por cada noticia
                const catNombre = noticia.categoria?.trim() || 'default';
                const estiloBadge =
                    coloresCategorias[catNombre] ||
                    coloresCategorias['default'];

                return (
                    <div class="flex flex-col group border border-gray-200 rounded-2xl bg-white h-full overflow-hidden shadow-sm transition-shadow hover:shadow-md">
                        {/* Imagen */}
                        <div class="overflow-hidden h-64 w-full">
                            <img
                                src={noticia.imagen}
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                referrerpolicy="no-referrer"
                                alt={noticia.titulo}
                            />
                        </div>

                        {/* Cuerpo */}
                        <div class="p-5 flex flex-col grow">
                            <div class="flex justify-between items-center mb-4">
                                <span
                                    class={`text-[10px] uppercase font-bold px-2 py-1 rounded-md ${estiloBadge}`}
                                >
                                    {noticia.categoria}
                                </span>
                                <span class="text-xs text-gray-400">
                                    {formatFecha(noticia.fecha_publicacion)}
                                </span>
                            </div>

                            <h2 class="text-xl font-bold mb-2 leading-tight group-hover:text-blue-600 transition-colors">
                                {noticia.titulo}
                            </h2>

                            {/* flex-grow en el párrafo para empujar el botón al fondo */}
                            <p class="text-sm text-gray-600 line-clamp-3 mb-6 grow">
                                {noticia.resumen}
                            </p>

                            <div class="pt-4 border-t border-gray-100">
                                <a
                                    href={noticia.url}
                                    target="_blank"
                                    class="inline-block w-full text-center font-semibold text-sm text-blue-600 bg-blue-50 hover:bg-blue-100 rounded-lg py-2 transition-colors"
                                >
                                    Leer Artículo
                                </a>
                            </div>
                        </div>
                    </div>
                );
            })
        }
    </div>
</div>
