---
import MainCarrusel from './MainCarrusel';
interface Noticias {
    imagen: string;
    titulo: string;
    fuente: string;
    resumen: string;
    url: string;
    fecha_publicacion: string | Date;
    categoria: string;
}
const { noticias } = Astro.props;
---

<MainCarrusel client:load noticias={noticias} />
